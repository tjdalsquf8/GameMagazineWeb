# App
NODE_ENV=development
PORT=3001

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/game_magazine

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars

# Naver SMTP 메일 발송
MAIL_HOST=smtp.naver.com
MAIL_PORT=465
MAIL_USER=                  # 네이버 아이디@naver.com
MAIL_PASSWORD=              # 네이버 앱 비밀번호 (2차 인증 사용 시 앱 비밀번호 발급)
MAIL_FROM=                  # 발신자 표시명 (예: Game Magazine <아이디@naver.com>)
