// ============================
// Game Magazine - Prisma Schema
// ============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// Enums
// ============================

enum Role {
  USER
  ADMIN
}

enum NewsStatus {
  PUBLISHED
  HIDDEN
}

enum Provider {
  EMAIL
  GOOGLE
}

// ============================
// 유저
// ============================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String?   // OAuth 유저는 null
  nickname     String    @unique
  profileImage String?   @map("profile_image")
  role         Role      @default(USER)
  provider     Provider  @default(EMAIL)
  isBanned     Boolean   @default(false) @map("is_banned")
  bannedUntil  DateTime? @map("banned_until")
  banReason    String?   @map("ban_reason")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  posts                Post[]
  comments             Comment[]
  postLikes            PostLike[]
  postRecommends       PostRecommend[]
  commentRecommends    CommentRecommend[]
  newsRecommends       NewsRecommend[]
  reports              Report[]
  refreshTokens        RefreshToken[]
  editorPickArticles   EditorPickArticle[]

  @@map("users")
}

// ============================
// Refresh Token
// ============================

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================
// 이메일 인증
// ============================

model EmailVerification {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  code       String
  expiresAt  DateTime @map("expires_at")
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("email_verifications")
}

// ============================
// 비밀번호 재설정 토큰
// ============================

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// ============================
// 커뮤니티 카테고리 (계층형)
// ============================

model Category {
  id       Int    @id @default(autoincrement())
  name     String @unique
  slug     String @unique
  parentId Int?   @map("parent_id")

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  posts    Post[]

  @@index([parentId])
  @@map("categories")
}

// ============================
// 커뮤니티 게시글
// ============================

model Post {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  content    String    @db.Text
  images     String[]  @default([])
  viewCount  Int       @default(0) @map("view_count")
  status     String    @default("PUBLISHED")
  authorId   String?   @map("author_id")
  categoryId Int       @map("category_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  author         User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category       Category        @relation(fields: [categoryId], references: [id])
  comments       Comment[]
  postLikes      PostLike[]
  postRecommends PostRecommend[]

  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

// ============================
// 커뮤니티 댓글
// ============================

model Comment {
  id        Int       @id @default(autoincrement())
  content   String    @db.Text
  postId    Int       @map("post_id")
  authorId  String?   @map("author_id")
  parentId  Int?      @map("parent_id")
  isHidden  Boolean   @default(false) @map("is_hidden")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post              Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  author            User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent            Comment?           @relation("CommentReplies", fields: [parentId], references: [id])
  replies           Comment[]          @relation("CommentReplies")
  commentRecommends CommentRecommend[]

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}


// ============================
// 게시글 추천
// ============================

model PostRecommend {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  postId Int    @map("post_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("post_recommends")
}

// ============================
// 댓글 추천
// ============================

model CommentRecommend {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  userId    String @map("user_id")
  commentId Int    @map("comment_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_recommends")
}

// ============================
// 뉴스 (자동 수집·재작성 파이프라인)
// ============================

model News {
  id                String    @id @default(cuid())

  // 원문 정보
  originalTitle     String    @map("original_title")
  originalLink      String    @unique @map("original_link")
  originalPubDate   DateTime? @map("original_pub_date")
  sourceName        String    @map("source_name")

  // 카테고리
  mainCategory      String    @map("main_category")
  subCategory       String    @map("sub_category")
  classifyMethod    String    @map("classify_method") // "keyword" | "claude"

  // 재작성 결과
  rewrittenTitle    String    @map("rewritten_title")
  rewrittenSummary  String    @map("rewritten_summary")
  rewrittenBody     String    @db.Text @map("rewritten_body")
  tags              String[]

  // 조회수
  viewCount         Int        @default(0) @map("view_count")

  // 상태
  status            NewsStatus @default(PUBLISHED)

  // 타임스탬프
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  recommends        NewsRecommend[]

  @@index([mainCategory, createdAt(sort: Desc)])
  @@index([subCategory, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("news")
}

// ============================
// 뉴스 추천
// ============================

model NewsRecommend {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  userId    String   @map("user_id")
  newsId    String   @map("news_id")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@index([newsId])
  @@map("news_recommends")
}

// ============================
// 파이프라인 로그 (어드민)
// ============================

model PipelineLog {
  id           String   @id @default(cuid())
  status       String   // "success" | "warning" | "error"
  message      String
  savedCount   Int      @default(0) @map("saved_count")
  skippedCount Int      @default(0) @map("skipped_count")
  failedCount  Int      @default(0) @map("failed_count")
  runAt        DateTime @default(now()) @map("run_at")

  @@index([runAt(sort: Desc)])
  @@map("pipeline_logs")
}

// ============================
// 뉴스 소스 (어드민)
// ============================

model NewsSource {
  id          String    @id @default(cuid())
  name        String
  url         String    @unique
  language    String    // "ko" | "en"
  platform    String?   // Console 소스인 경우 플랫폼명
  isActive    Boolean   @default(true) @map("is_active")
  lastFetchAt DateTime? @map("last_fetch_at")
  lastCount   Int       @default(0) @map("last_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("news_sources")
}

// ============================
// 뉴스 카테고리 (어드민 관리용)
// ============================

model NewsCategory {
  id           String   @id @default(cuid())
  mainCategory String   @map("main_category")
  name         String
  keywords     String[]
  excludes     String[]
  isActive     Boolean  @default(true) @map("is_active")
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([mainCategory, name])
  @@index([mainCategory, isActive])
  @@map("news_categories")
}

// ============================
// 시스템 설정 (키-값 영구 저장)
// ============================

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ============================
// 에디터 픽 아티클 (어드민 직접 작성)
// ============================

model EditorPickArticle {
  id           String    @id @default(cuid())
  title        String
  content      String    @db.Text
  mainCategory String    @map("main_category")
  thumbnailUrl String    @map("thumbnail_url")

  authorId     String    @map("author_id")
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  isHidden     Boolean   @default(false) @map("is_hidden")
  deletedAt    DateTime? @map("deleted_at")

  @@index([createdAt(sort: Desc)])
  @@index([authorId])
  @@map("editor_pick_articles")
}

// ============================
// 신고 (어드민)
// ============================

model Report {
  id         Int      @id @default(autoincrement())
  type       String   // "POST" | "COMMENT"
  targetId   Int      @map("target_id")
  reason     String
  status     String   @default("PENDING") // "PENDING" | "RESOLVED" | "REJECTED"
  reporterId String   @map("reporter_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId])
  @@map("reports")
}
